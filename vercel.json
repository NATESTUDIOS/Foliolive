{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/:username([a-z0-9_-]+)/project/:projectname([a-z0-9_-]+)/api/:route([a-z0-9_-]+)",
      "destination": "https://foliostudios.vercel.app/api/run?username=:username&project=:projectname&route=:route"
    },
    {
      "source": "/:username([a-z0-9_-]+)/project/:projectname([a-z0-9_-]+)/",
      "destination": "https://foliostudios.vercel.app/api/host?action=serve&username=:username&project=:projectname&path=index.html"
    },
    {
      "source": "/:username([a-z0-9_-]+)/project/:projectname([a-z0-9_-]+)/:path*",
      "destination": "https://foliostudios.vercel.app/api/host?action=serve&username=:username&project=:projectname&path=:path*"
    },
    {
      "source": "/:username([a-z0-9_-]+)/:project([a-z0-9_-]+)/",
      "destination": "https://foliostudios.vercel.app/api/host?action=share&username=:username&project=:project"
    },
    {
      "source": "/:username([a-z0-9_-]+)/:project([a-z0-9_-]+)",
      "destination": "https://foliostudios.vercel.app/api/host?action=share&username=:username&project=:project"
    },
    {
      "source": "/:username([a-z0-9_-]+)/",
      "destination": "https://foliostudios.vercel.app/api/host?action=profile&username=:username"
    },
    {
      "source": "/:username([a-z0-9_-]+)",
      "destination": "https://foliostudios.vercel.app/api/host?action=profile&username=:username"
    }
  ],
  "headers": [
    {
      "source": "/:username([a-z0-9_-]+)/project/:projectname([a-z0-9_-]+)/api/:route([a-z0-9_-]+)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:username([a-z0-9_-]+)/project/:projectname([a-z0-9_-]+)/:path*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:username([a-z0-9_-]+)/:project([a-z0-9_-]+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/:username([a-z0-9_-]+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=60" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}